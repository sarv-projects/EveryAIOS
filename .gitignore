# Rust
crates/target/
crates/Cargo.lock.orig
src-tauri/target/

# Node / TS (P0.3+)
node_modules/
packages/*/node_modules/
ui/node_modules/
dist/
*.tsbuildinfo

# OS junk
.DS_Store
Thumbs.db

# Editor / local
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# Local runtime state (never commit user data)
*.db
*.db-shm
*.db-wal

# P8.8 auto-updater signing keys (private key + password must never be committed)
.tauri/

# Uploaded screenshots (not project assets)
*.png
!icons/*.png

# P50.3 sidecar resource: the bun-compiled coordinator binary (97MB, built
# via `pnpm --filter @everyaios/coordinator build` + copy — never committed)
src-tauri/bin/
