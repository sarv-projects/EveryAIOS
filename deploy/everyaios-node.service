# EveryAIOS headless executor node — systemd unit (P40.1).
#
# Install:
#   sudo cp deploy/everyaios-node.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now everyaios-node
#
# The node runs the same binary in the headless profile: core + B7 scheduler
# (inside the Bun-compiled coordinator) + browser/script/office engines. The
# coordinator binary must be built first:
#   cd packages/coordinator && bun build --compile ./src/index.ts --external canvas --outfile dist/coordinator

[Unit]
Description=EveryAIOS always-on executor node (headless, user-operated)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The node's state lives here — create it and set permissions for the
# service user (never run as root if you can avoid it).
Environment=EVERYAIOS_HOME=/var/lib/everyaios
# The SQLCipher vault key (node identity + P8.9 mesh key material). Provide
# it via an EnvironmentFile, never inline:
#   EnvironmentFile=-/etc/everyaios-node.env
EnvironmentFile=-/etc/everyaios-node.env
ExecStart=/usr/local/bin/everyaios-core --headless --coordinator-bin /usr/local/bin/coordinator
Restart=on-failure
RestartSec=5
# Guard-2 never leaves the control plane: approval-required steps park here.
# Keep the node's disk bounded (audit NDJSON retention is 7 days by default).
User=everyaios
Group=everyaios

[Install]
WantedBy=multi-user.target
