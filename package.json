{
  "name": "everyaios-desktop-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "EveryAIOS desktop workspace (Tauri shell + TS coordinator sidecar)",
  "scripts": {
    "coordinator:dev": "pnpm --filter @everyaios/coordinator dev",
    "coordinator:test": "pnpm --filter @everyaios/coordinator test",
    "coordinator:typecheck": "pnpm --filter @everyaios/coordinator type-check",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:verify-clean-boot": "node scripts/clean-profile-boot-check.mjs",
    "ipc:parity": "node scripts/ipc-parity.mjs --md",
    "check:arch": "node scripts/check-arch-invariants.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:release-matrix": "node scripts/check-release-matrix.mjs",
    "check:app-metadata": "node scripts/check-app-metadata.mjs",
    "check:native-deps": "node scripts/check-native-deps.mjs",
    "check:size-budget": "node scripts/check-size-budget.mjs",
    "check:store-schemas": "node scripts/check-store-schemas.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "check:updater-keys": "node scripts/check-updater-keys.mjs",
    "check:update-pipeline": "node scripts/check-update-pipeline.mjs",
    "gen:sbom": "node scripts/gen-sbom.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
