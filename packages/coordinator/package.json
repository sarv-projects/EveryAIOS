{
  "name": "@everyaios/coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EveryAIOS TS sidecar — the supervised agent-loop engine (P0.3). A sidecar binary, not a library — no `main` entry (build emits a compiled binary via `bun build --compile`).",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile ./src/index.ts --external canvas --outfile dist/coordinator",
    "type-check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@everyaios/core-ai": "workspace:*",
    "@everyaios/core-connectors": "workspace:*",
    "@everyaios/core-engine": "workspace:*",
    "@everyaios/core-providers": "workspace:*",
    "@everyaios/core-search": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
